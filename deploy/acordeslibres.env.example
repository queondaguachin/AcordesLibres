# Variables de entorno para systemd — /etc/acordeslibres.env
# Permisos recomendados: chown root:root y chmod 600

HOST=127.0.0.1
PORT=8080
AL_TRUST_PROXY=1

# Deja el registro ABIERTO hasta crear tu cuenta de administrador.
# Después cambia esta línea por: AL_REGISTRATION=closed
AL_REGISTRATION=open

# Genera una cadena larga y única y NO la subas al repositorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la pierdes, las cuentas creadas con ella no podrán iniciar sesión.
AL_PEPPER=cambia-esto-por-una-cadena-larga-y-aleatoria

# Dominio público (para los enlaces de recuperación)
AL_PUBLIC_URL=https://tudominio.com

# Correo: console (solo pruebas), resend, brevo o smtp
AL_MAIL_TRANSPORT=resend
AL_MAIL_FROM=no-reply@tudominio.com
AL_MAIL_NAME=AcordesLibres
AL_RESEND_KEY=re_cambia_esto

# Alternativa Brevo:
# AL_MAIL_TRANSPORT=brevo
# AL_BREVO_KEY=xkeysib-cambia-esto

# Alternativa SMTP (requiere: npm install nodemailer):
# AL_MAIL_TRANSPORT=smtp
# AL_SMTP_HOST=smtp.tudominio.com
# AL_SMTP_PORT=587
# AL_SMTP_SECURE=0
# AL_SMTP_USER=no-reply@tudominio.com
# AL_SMTP_PASS=cambia-esto
